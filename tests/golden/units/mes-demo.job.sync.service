# Made by my-easy-software (mes). Do not edit: run 'mes server plan' again and the script it writes instead.
# mes-project: demo
# mes-unit: job
# mes-job: sync
# network: only api.example.com, auth.example.com (their addresses are looked up again before each run)

[Unit]
Description=mes job sync of project demo
Requires=mes-demo.net.sync.service
After=mes-demo.net.sync.service
OnSuccess=mes-demo.job.build.service

[Service]
Type=oneshot
User=mes-demo
Group=mes-demo
ExecStart="/var/lib/mes/demo/code/current/project/.venv/bin/demo" "--json" "sync" "--days" "3"
ExecStopPost=+"/usr/local/bin/mes" "jobs" "record" "--project" "demo" "--server-root" "/var/lib/mes" "sync"
WorkingDirectory=/var/lib/mes/demo/code/current/project
Environment="MES_PROJECT=demo"
Environment="MES_DATA_DIR=/var/lib/mes/demo/data"
Environment="MES_STATE_DIR=/var/lib/mes/demo/state"
Environment="MES_STORE_DIR=/var/lib/mes/demo/store"
Environment="HOME=/var/lib/mes/demo/state"
Environment="LANG=C.UTF-8"
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="MES_ALLOW=write"
Environment="MES_JOB=sync"
Slice=mes.slice
MemoryMax=512M
MemorySwapMax=0
TimeoutStartSec=1200
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
LimitCORE=0
TasksMax=256
ReadWritePaths=/var/lib/mes/demo/data /var/lib/mes/demo/store /var/lib/mes/demo/state
InaccessiblePaths=-/var/lib/mes/demo/etc/webhook.key
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
