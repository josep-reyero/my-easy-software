# Made by my-easy-software (mes). Do not edit: run 'mes server plan' again and the script it writes instead.
# mes-project: demo
# mes-unit: job
# mes-job: sync
# network: only api.example.com, auth.example.com (their addresses are looked up again before each run)

[Unit]
Description=mes job sync of project demo
Requires=mes-demo.net.sync.service
After=mes-demo.net.sync.service
OnSuccess=mes-demo.job.build.service

[Service]
Type=oneshot
User=mes-demo
Group=mes-demo
ExecStart="/var/lib/mes/demo/code/current/project/.venv/bin/demo" "--json" "sync" "--days" "3"
# Root records the run with an empty environment and Python's isolated mode: nothing the
# job can write reaches it.
ExecStopPost=+"/usr/bin/env" "-i" "PATH=/usr/bin:/bin" "LANG=C.UTF-8" "/opt/mes/tools/my-easy-software/bin/python" "-I" "-m" "mes" "jobs" "record" "--project" "demo" "--server-root" "/var/lib/mes" "sync"
WorkingDirectory=/var/lib/mes/demo/code/current/project
Environment="MES_PROJECT=demo"
Environment="MES_DATA_DIR=/var/lib/mes/demo/data"
Environment="MES_STATE_DIR=/var/lib/mes/demo/state"
Environment="MES_STORE_DIR=/var/lib/mes/demo/store"
Environment="HOME=/var/lib/mes/demo/state"
Environment="LANG=C.UTF-8"
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="MES_ALLOW=write"
Environment="MES_JOB=sync"
Slice=mes.slice
MemoryMax=512M
MemorySwapMax=0
TimeoutStartSec=1200
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
LimitCORE=0
TasksMax=256
# Of all the projects' folders, only these of this project are there (read-only unless listed
# as writable); other projects, the sign-in folder and the gate's own folder are not.
TemporaryFileSystem=/var/lib/mes:ro
BindReadOnlyPaths=/var/lib/mes/demo/code
BindPaths=/var/lib/mes/demo/data /var/lib/mes/demo/store /var/lib/mes/demo/state
ReadWritePaths=/var/lib/mes/demo/data /var/lib/mes/demo/store /var/lib/mes/demo/state
# The job's own /etc/hosts, written just before the run: the only names it can look up. It has
# no DNS server and no access to the system's name service.
BindReadOnlyPaths=/run/mes-demo-net/sync/hosts:/etc/hosts
InaccessiblePaths=-/run/mes-demo-gate -/var/lib/mes/demo/etc/webhook.key -/run/systemd/resolve -/run/dbus
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
