# Made by my-easy-software (mes). Do not edit: run 'mes server plan' again and the script it writes instead.
# mes-project: demo
# mes-unit: net
# mes-job: sync
# Runs as root just before each start of the job: it looks up the job's hosts and lets the
# job reach only those addresses (and the DNS servers). It reads nothing from the project.

[Unit]
Description=Allow the network hosts of mes job sync of project demo
Before=mes-demo.job.sync.service

[Service]
Type=oneshot
ExecStart="/usr/local/bin/mes" "jobs" "allow-network" "--unit" "mes-demo.job.sync.service" "--" "api.example.com" "auth.example.com"
WorkingDirectory=/
Environment="LANG=C.UTF-8"
TimeoutStartSec=60
UMask=0077
NoNewPrivileges=yes
# Only the right to change unit settings (systemd asks for CAP_SYS_ADMIN for that).
CapabilityBoundingSet=CAP_SYS_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
