# Made by my-easy-software (mes). Do not edit: run 'mes server plan' again and the script it writes instead.
# mes-project: demo
# mes-unit: job
# mes-job: demo-app.build
# network: none

[Unit]
Description=mes job demo-app.build of project demo
OnSuccess=mes-demo.job.demo-tool.report.service mes-demo.ui-refresh.service

[Service]
Type=oneshot
User=mes-demo
Group=mes-demo
# First the shared database is brought in line with project.toml, by mes itself, as this
# account, with an empty environment and Python's isolated mode.
ExecStartPre="/usr/bin/env" "-i" "PATH=/usr/bin:/bin" "LANG=C.UTF-8" "HOME=/nonexistent" "MES_CONFIG=/nonexistent" "PYTHONDONTWRITEBYTECODE=1" "MES_PROJECT=demo" "MES_DATA_DIR=/var/lib/mes/demo/data" "MES_STATE_DIR=/var/lib/mes/demo/state" "MES_STORE_DIR=/var/lib/mes/demo/store" "MES_PROJECT_DIR=/var/lib/mes/demo/code/current/project" "MES_ALLOW=write" "/opt/mes/tools/my-easy-software/bin/python" "-I" "-m" "mes" "db" "sync" "--quiet" "--project-dir" "/var/lib/mes/demo/code/current/project"
ExecStart="/var/lib/mes/demo/code/current/project/.venv/bin/demo-app" "--json" "build" "50%% done" "$$HOME"
# Root records the run with an empty environment and Python's isolated mode: nothing the
# job can write reaches it.
ExecStopPost=+"/usr/bin/env" "-i" "PATH=/usr/bin:/bin" "LANG=C.UTF-8" "/opt/mes/tools/my-easy-software/bin/python" "-I" "-m" "mes" "jobs" "record" "--project" "demo" "--server-root" "/var/lib/mes" "demo-app.build"
WorkingDirectory=/var/lib/mes/demo/code/current/project
Environment="MES_PROJECT=demo"
Environment="MES_DATA_DIR=/var/lib/mes/demo/data"
Environment="MES_STATE_DIR=/var/lib/mes/demo/state"
Environment="MES_STORE_DIR=/var/lib/mes/demo/store"
Environment="HOME=/var/lib/mes/demo/state"
Environment="LANG=C.UTF-8"
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="MES_PROJECT_DIR=/var/lib/mes/demo/code/current/project"
Environment="MES_ALLOW=write"
Environment="MES_JOB=demo-app.build"
Slice=mes.slice
MemoryMax=256M
MemorySwapMax=0
TimeoutStartSec=900
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
LimitCORE=0
TasksMax=256
# Of all the projects' folders, only these of this project are there (read-only unless listed
# as writable); other projects, the sign-in folder and the gate's own folder are not.
TemporaryFileSystem=/var/lib/mes:ro
BindReadOnlyPaths=/var/lib/mes/demo/code /var/lib/mes/demo/state
BindPaths=/var/lib/mes/demo/data /var/lib/mes/demo/store
ReadWritePaths=/var/lib/mes/demo/data /var/lib/mes/demo/store
InaccessiblePaths=-/run/mes-demo-gate -/var/lib/mes/demo/etc/webhook.key
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
