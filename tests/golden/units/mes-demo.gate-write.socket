# Made by my-easy-software (mes). Do not edit: run 'mes server plan' again and the script it writes instead.
# mes-project: demo
# mes-unit: gate-write
# Each connection gets its own sandboxed instance of mes-demo.gate-write@.service.
# Only the account mes-demo can connect, and each instance accepts only an SSH
# session of that account (never a job). No unit that runs project code can see this socket's folder.

[Unit]
Description=Sandboxed write requests of the mes gate for project demo (socket)

[Socket]
ListenStream=/run/mes-demo-gate/write.sock
SocketUser=mes-demo
SocketGroup=mes-demo
SocketMode=0600
DirectoryMode=0755
Accept=yes
MaxConnections=4

[Install]
WantedBy=sockets.target
