# Made by my-easy-software (mes). Do not edit: run 'mes server plan' again and the script it writes instead.
# mes-project: demo
# mes-unit: gate-deploy

[Unit]
Description=One deploy request of the mes gate for project demo

[Service]
Type=simple
User=mes-demo
Group=mes-demo
ExecStart="/usr/local/bin/mes" "gate" "child" "--project" "demo" "--server-root" "/var/lib/mes" "--level" "deploy"
StandardInput=socket
StandardOutput=socket
StandardError=journal
WorkingDirectory=/
Environment="MES_PROJECT=demo"
Environment="MES_DATA_DIR=/var/lib/mes/demo/data"
Environment="MES_STATE_DIR=/var/lib/mes/demo/state"
Environment="MES_STORE_DIR=/var/lib/mes/demo/store"
Environment="HOME=/nonexistent"
Environment="LANG=C.UTF-8"
Environment="PYTHONDONTWRITEBYTECODE=1"
Slice=mes.slice
MemoryMax=2G
MemorySwapMax=0
RuntimeMaxSec=1800
# Installs a new release and nothing else: uv puts the locked third-party packages into the new
# release's fresh environment, and mes unpacks the release's own wheels itself. No project code
# runs here (uv never starts the new environment's Python), and it sees no data, state, ui,
# store, gate or sign-in folder. uv's cache and Python are in code/, which only this step writes.
Environment="UV_CACHE_DIR=/var/lib/mes/demo/code/uv-cache"
Environment="UV_PYTHON_INSTALL_DIR=/var/lib/mes/demo/code/uv-python"
Environment="UV_NO_CONFIG=1"
Environment="UV_LINK_MODE=copy"
Environment="PYTHONNOUSERSITE=1"
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=@chown
SystemCallErrorNumber=EPERM
LimitCORE=0
TasksMax=256
TemporaryFileSystem=/var:ro /run:ro /opt:ro /usr/local:ro
BindReadOnlyPaths=-/opt/mes -/usr/local/bin -/usr/local/lib -/usr/local/lib64
InaccessiblePaths=-/srv -/mnt -/media -/boot -/efi
InaccessiblePaths=-/etc/shadow -/etc/shadow- -/etc/gshadow -/etc/gshadow- -/etc/sudoers -/etc/sudoers.d -/etc/ssh -/etc/ssl/private -/etc/pki/tls/private -/etc/letsencrypt -/etc/credstore -/etc/credstore.encrypted -/etc/NetworkManager -/etc/wireguard -/etc/systemd/network -/etc/netctl -/etc/wpa_supplicant -/etc/iwd -/etc/openvpn -/etc/ppp -/etc/ipsec.d -/etc/ipsec.secrets -/etc/krb5.keytab -/etc/docker -/etc/containers -/etc/tailscale -/etc/libvirt -/etc/samba -/etc/cups -/etc/polkit-1 -/etc/security -/etc/crypttab
# Of all the projects' folders, only these of this project are there (read-only unless listed
# as writable); other projects, the sign-in folder and the gate's own folder are not.
BindReadOnlyPaths=/var/lib/mes/demo/etc /var/lib/mes/demo/code
# Writable: uv's cache and Python, and the new release only: code/installing is a link the gate
# points at releases/<n> just before this step; every other release stays read-only.
BindPaths=-/var/lib/mes/demo/code/uv-cache -/var/lib/mes/demo/code/uv-python -/var/lib/mes/demo/code/installing
InaccessiblePaths=-/var/lib/mes/demo/etc/webhook.key -/var/lib/mes/demo/code/incoming
# Names are looked up through systemd-resolved's socket (its address 127.0.0.53 is blocked).
BindReadOnlyPaths=-/run/systemd/resolve/io.systemd.Resolve
# uv needs the package index, but nothing on this computer or the local network: this computer,
# link-local, multicast, private, Tailscale (100.64.0.0/10) and IPv6 unique-local addresses are blocked.
# Not covered: this server's own public addresses and the global IPv6 addresses of other machines on
# the local network (they cannot be known when this file is written).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=localhost link-local multicast 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 172.16.0.0/12 192.0.0.0/24 192.168.0.0/16 198.18.0.0/15 240.0.0.0/4 ::/128 64:ff9b:1::/48 fc00::/7 fec0::/10
