# Made by my-easy-software (mes). Do not edit: run 'mes server plan' again and the script it writes instead.
# mes-project: demo
# mes-unit: selftest
# network: none

[Unit]
Description=mes self-test probe of project demo (the sandbox of a job that waits for another)
# Ordering only: the job before it stays loaded, with how its run ended, until root's check
# below has read it.
After=mes-demo.selftest.service

[Service]
Type=oneshot
User=mes-demo
Group=mes-demo
# Root skips this run when the job before it only stopped for a temporary problem.
ExecCondition=+"/usr/bin/env" "-i" "PATH=/usr/bin:/bin" "LANG=C.UTF-8" "/opt/mes/my-easy-software/.venv/bin/python" "-I" "-m" "mes" "jobs" "should-run" "--project" "demo" "--server-root" "/var/lib/mes" "--selftest"
ExecStart="/usr/local/bin/mes" "server" "selftest-probe" "demo" "--context" "after" "--server-root" "/var/lib/mes"
WorkingDirectory=/var/lib/mes/demo/code/current/project
Environment="MES_PROJECT=demo"
Environment="MES_DATA_DIR=/var/lib/mes/demo/data"
Environment="MES_STATE_DIR=/var/lib/mes/demo/state"
Environment="MES_STORE_DIR=/var/lib/mes/demo/store"
Environment="HOME=/var/lib/mes/demo/state"
Environment="LANG=C.UTF-8"
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="MES_PROJECT_DIR=/var/lib/mes/demo/code/current/project"
Environment="MES_ALLOW=write"
Environment="MES_JOB=demo-app.selftest"
Slice=mes.slice
MemoryMax=128M
MemorySwapMax=0
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
LimitCORE=0
TasksMax=256
TemporaryFileSystem=/var:ro /run:ro /opt:ro /usr/local:ro
BindReadOnlyPaths=-/opt/mes -/usr/local/bin -/usr/local/lib -/usr/local/lib64
InaccessiblePaths=-/srv -/mnt -/media -/boot -/efi
InaccessiblePaths=-/etc/shadow -/etc/shadow- -/etc/gshadow -/etc/gshadow- -/etc/sudoers -/etc/sudoers.d -/etc/ssh -/etc/ssl/private -/etc/pki/tls/private -/etc/letsencrypt -/etc/credstore -/etc/credstore.encrypted -/etc/NetworkManager -/etc/wireguard -/etc/systemd/network -/etc/netctl -/etc/wpa_supplicant -/etc/iwd -/etc/openvpn -/etc/ppp -/etc/ipsec.d -/etc/ipsec.secrets -/etc/krb5.keytab -/etc/docker -/etc/containers -/etc/tailscale -/etc/libvirt -/etc/samba -/etc/cups -/etc/polkit-1 -/etc/security -/etc/crypttab
# Of all the projects' folders, only these of this project are there (read-only unless listed
# as writable); other projects, the sign-in folder and the gate's own folder are not.
BindReadOnlyPaths=/var/lib/mes/demo/code
BindPaths=/var/lib/mes/demo/data /var/lib/mes/demo/store /var/lib/mes/demo/state
ReadWritePaths=/var/lib/mes/demo/data /var/lib/mes/demo/store /var/lib/mes/demo/state
BindPaths=-/var/lib/mes/demo/gate/selftest
# Root's check before the run asks systemd (systemctl) through its control socket, which the
# empty /run would hide; systemctl first looks for /run/systemd/system, for which an empty
# read-only folder stands in. Only root may connect to the socket, so this unit's account gains
# nothing from either.
BindReadOnlyPaths=/run/systemd/private
TemporaryFileSystem=/run/systemd/system:ro
InaccessiblePaths=-/var/lib/mes/demo/etc/webhook.key -/var/lib/mes/demo/code/incoming -/var/lib/mes/demo/code/uv-cache
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
