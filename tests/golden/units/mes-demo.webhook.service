# Made by my-easy-software (mes). Do not edit: run 'mes server plan' again and the script it writes instead.
# mes-project: demo
# mes-unit: webhook
# It sees only etc/ (the secret and the list of webhook jobs, both written by root) and its own
# webhook/ folder (the replay record and the trigger notes), which no job can write.

[Unit]
Description=Signed webhooks of project demo
Requires=mes-demo.webhook.socket
After=mes-demo.webhook.socket

[Service]
Type=simple
User=mes-demo
Group=mes-demo
ExecStart="/usr/local/bin/mes" "webhook" "serve" "--project" "demo" "--server-root" "/var/lib/mes"
WorkingDirectory=/
Environment="MES_PROJECT=demo"
Environment="MES_DATA_DIR=/var/lib/mes/demo/data"
Environment="MES_STATE_DIR=/var/lib/mes/demo/state"
Environment="MES_STORE_DIR=/var/lib/mes/demo/store"
Environment="HOME=/var/lib/mes/demo/state"
Environment="LANG=C.UTF-8"
Environment="PYTHONDONTWRITEBYTECODE=1"
Slice=mes.slice
MemoryMax=128M
RuntimeMaxSec=3600
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
LimitCORE=0
TasksMax=256
TemporaryFileSystem=/var:ro /run:ro /opt:ro /usr/local:ro
BindReadOnlyPaths=-/opt/mes -/usr/local/bin -/usr/local/lib -/usr/local/lib64
InaccessiblePaths=-/srv -/mnt -/media -/boot -/efi
InaccessiblePaths=-/etc/shadow -/etc/shadow- -/etc/gshadow -/etc/gshadow- -/etc/sudoers -/etc/sudoers.d -/etc/ssh -/etc/ssl/private -/etc/pki/tls/private -/etc/letsencrypt -/etc/credstore -/etc/credstore.encrypted -/etc/NetworkManager -/etc/wireguard -/etc/systemd/network -/etc/netctl -/etc/wpa_supplicant -/etc/iwd -/etc/openvpn -/etc/ppp -/etc/ipsec.d -/etc/ipsec.secrets -/etc/krb5.keytab -/etc/docker -/etc/containers -/etc/tailscale -/etc/libvirt -/etc/samba -/etc/cups -/etc/polkit-1 -/etc/security -/etc/crypttab
# Of all the projects' folders, only these of this project are there (read-only unless listed
# as writable); other projects, the sign-in folder and the gate's own folder are not.
BindReadOnlyPaths=/var/lib/mes/demo/etc
BindPaths=/var/lib/mes/demo/webhook
ReadWritePaths=/var/lib/mes/demo/webhook
# No network of its own: requests arrive only through the socket.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
