# Made by my-easy-software (mes). Do not edit: run 'mes server plan' again and the script it writes instead.
# mes-project: demo
# mes-unit: gate-write

[Unit]
Description=One write request of the mes gate for project demo

[Service]
Type=simple
User=mes-demo
Group=mes-demo
ExecStart="/usr/local/bin/mes" "gate" "child" "--project" "demo" "--server-root" "/var/lib/mes" "--level" "write"
StandardInput=socket
StandardOutput=socket
StandardError=journal
WorkingDirectory=/
Environment="MES_PROJECT=demo"
Environment="MES_DATA_DIR=/var/lib/mes/demo/data"
Environment="MES_STATE_DIR=/var/lib/mes/demo/state"
Environment="MES_STORE_DIR=/var/lib/mes/demo/store"
Environment="HOME=/var/lib/mes/demo/state"
Environment="LANG=C.UTF-8"
Environment="PYTHONDONTWRITEBYTECODE=1"
Slice=mes.slice
MemoryMax=2G
MemorySwapMax=0
RuntimeMaxSec=3700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
LimitCORE=0
TasksMax=256
ReadWritePaths=/var/lib/mes/demo/data /var/lib/mes/demo/state /var/lib/mes/demo/store
InaccessiblePaths=-/var/lib/mes/demo/state/gate -/var/lib/mes/demo/etc/webhook.key -/var/lib/mes/demo/code/incoming
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
