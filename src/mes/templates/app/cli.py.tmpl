"""The command-line tool of this app, built on the my-easy-software App SDK.

Every command has a kind: "read" (only looks), "write" (changes data) or
"admin" (changes how the app is set up). Add --json, before or after the
command, to get only JSON data on stdout. Start with: {{name}} --json describe

Where the data lives (on this computer, never inside this folder):
- raw/notes.jsonl     the raw data and the source of truth; only ever added to.
- derived/daily.json  a derived table (notes per day), rebuilt from the raw data
                      by the "rebuild" job, so it can always be thrown away.
"""

from __future__ import annotations

import json
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path
from typing import Annotated, Any

from mes import App, UsageError

app = App("{{name}}")


def _raw_file(ctx) -> Path:
    return ctx.data_dir / "raw" / "notes.jsonl"


def _read_notes(ctx) -> list[dict[str, Any]]:
    path = _raw_file(ctx)
    if not path.exists():
        return []
    lines = path.read_text(encoding="utf-8").splitlines()
    return [json.loads(line) for line in lines if line.strip()]


@app.command("notes", kind="read")
def notes(ctx, last: Annotated[int, "how many of the newest notes to show"] = 10):
    """Show the newest notes, newest first."""
    if last < 1:
        raise UsageError(
            f"--last must be 1 or more, but it was {last}, so there is nothing to show.",
            hint="Leave it out to see the 10 newest notes, or use for example --last 5.",
        )
    rows = list(reversed(_read_notes(ctx)))[:last]
    if not rows and not ctx.json:
        return 'No notes yet. Add one with: {{name}} add "Bought milk"'
    return rows


@app.command("add", kind="write")
def add(ctx, text: Annotated[str, "the note to save"]):
    """Save a new note."""
    text = text.strip()
    if not text:
        raise UsageError(
            "The note is empty, so nothing was saved.",
            hint='Give the text of the note, for example: {{name}} add "Bought milk"',
        )
    row = {"time": datetime.now(timezone.utc).isoformat(timespec="seconds"), "text": text}
    path = _raw_file(ctx)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as f:
        f.write(json.dumps(row, ensure_ascii=False) + "\n")
    return {"saved": True, **row}


@app.command("rebuild", kind="write")
def rebuild(ctx):
    """Rebuild the derived table of notes per day from the raw notes (the "rebuild" job)."""
    per_day = Counter(row["time"][:10] for row in _read_notes(ctx))
    table = [{"day": day, "notes": count} for day, count in sorted(per_day.items(), reverse=True)]
    folder = ctx.data_dir / "derived"
    folder.mkdir(parents=True, exist_ok=True)
    tmp = folder / "daily.json.tmp"
    tmp.write_text(json.dumps(table, indent=2) + "\n", encoding="utf-8")
    tmp.replace(folder / "daily.json")  # all at once, so readers never see half a file
    return {"table": "daily", "rows": len(table), "notes": sum(per_day.values())}


@app.schema
def schema(ctx):
    return {
        "tables": [
            {"name": "notes", "layer": "raw", "fields": {"time": "UTC date and time", "text": "the note"}},
            {"name": "daily", "layer": "derived", "built_by": "rebuild",
             "fields": {"day": "date (YYYY-MM-DD, UTC)", "notes": "number of notes that day"}},
        ]
    }


@app.sources
def sources(ctx):
    return [{"name": "manual", "meaning": "Notes typed in with the add command."}]


def main() -> None:
    app.main()


if __name__ == "__main__":
    main()
