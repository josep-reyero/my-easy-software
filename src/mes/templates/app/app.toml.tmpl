# What this app is. Read by mes and by the app's own command-line tool.
[app]
name = "{{name}}"
title = {{title_toml}}
version = "0.1.0"

# Jobs: short runs of this app's own commands that mes starts for you and that
# stop when they are done. Each job has exactly one trigger: schedule = "...",
# after = "<another job>" or manual = true. See: mes guide jobs
[jobs.rebuild]
run = "rebuild"          # runs: {{name}} rebuild
manual = true            # only when someone asks: mes jobs run rebuild
# schedule = "*-*-* 06:00:00"   # use this instead of manual to run it every day at 06:00
timeout = "5m"           # stopped if it takes longer than 5 minutes
network = false          # it never needs the internet
