# What this project is. Read by mes, by the project's command ({{name}}) and by the dashboard
# server (easy-ui). See: mes guide new-project
[project]
name = "{{name}}"
title = {{title_toml}}
version = "0.1.0"
apps = ["{{package}}"]   # the project's apps (Python packages in apps/ or installed); order matters

# A shared table: any app of the project may add rows to it, and every row says which app wrote
# it (the column "source", added by mes). Dashboards and agents read the view "daily".
[tables.daily]
key = ["day"]
columns = { day = "text", notes = "integer" }

[ui]
dashboards = ["overview"]
refresh_after = ["{{app}}.rebuild"]   # on a server, the dashboard data is rebuilt after this job succeeds
