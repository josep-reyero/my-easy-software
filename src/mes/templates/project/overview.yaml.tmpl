# The overview dashboard of this project, for the dashboard server my-easy-ui (the easy-ui
# command). A dashboard is a page made of named, read-only queries and fixed components: no
# JavaScript, HTML or CSS. See every component with: easy-ui components. Check it with: easy-ui validate
#
# The queries read the shared view "daily" (one row per day and app: source, day, notes). Apps can
# add their own sections to this dashboard; they go where the "anchor: apps" line is (or at the end).
spec: easy-ui/v1
title: {{title_yaml}}
description: Notes added per day.

params:
  days:
    type: choice
    label: Days
    default: 30
    options:
      - {value: 7, label: 7 days}
      - {value: 30, label: 30 days}
      - {value: 365, label: 365 days}

queries:
  total:
    sql: |
      SELECT coalesce(sum(notes), 0) AS notes FROM daily
      WHERE day > date('now', '-' || :days || ' days')
  daily:
    sql: |
      SELECT day, sum(notes) AS "Notes" FROM daily
      WHERE day > date('now', '-' || :days || ' days')
      GROUP BY day
      ORDER BY day DESC

layout:
  - - type: controls
  - - type: stat
      title: Notes in this period
      query: total
      value: notes
      format: integer
  - anchor: apps
  - - type: bar
      title: Notes per day
      query: daily
      x: day
      y: Notes
      format: integer
    - type: table
      title: Notes per day
      query: daily
      limit: 30
      columns:
        - {column: day, label: Day, format: date}
        - {column: Notes, format: integer}
