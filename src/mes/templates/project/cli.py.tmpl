"""The command-line tool of this project, built on the my-easy-software App SDK.

Every command has a kind: "read" (only looks), "write" (changes data) or "admin" (changes how
the project is set up). Add --json, before or after the command, to get only JSON data on stdout.
Start with: {{name}} --json describe

The data lives in one SQLite file on this computer, never inside this folder:
- table "notes" is the raw data and the source of truth; rows are only ever added.
- table "daily" (notes per day) is derived: the "rebuild" job builds it from "notes", so it can
  always be thrown away and built again. The dashboard in ui/dashboards/main.yaml reads it.
"""

from __future__ import annotations

import sqlite3
from contextlib import closing
from datetime import datetime, timezone
from typing import Annotated

from mes import App, UsageError

app = App("{{name}}")

DATA_FILE = "{{name}}.sqlite"  # the same name as [ui] data in project.toml


def _connect(ctx) -> sqlite3.Connection:
    conn = sqlite3.connect(ctx.data_dir / DATA_FILE)
    conn.row_factory = sqlite3.Row
    conn.execute("CREATE TABLE IF NOT EXISTS notes (id INTEGER PRIMARY KEY, time TEXT NOT NULL, text TEXT NOT NULL)")
    conn.execute("CREATE TABLE IF NOT EXISTS daily (day TEXT PRIMARY KEY, notes INTEGER NOT NULL)")
    return conn


@app.command("notes", kind="read")
def notes(ctx, last: Annotated[int, "how many of the newest notes to show"] = 10):
    """Show the newest notes, newest first."""
    if last < 1:
        raise UsageError(
            f"--last must be 1 or more, but it was {last}, so there is nothing to show.",
            hint="Leave it out to see the 10 newest notes, or use for example --last 5.",
        )
    with closing(_connect(ctx)) as conn:
        rows = [dict(r) for r in conn.execute("SELECT time, text FROM notes ORDER BY id DESC LIMIT ?", (last,))]
    if not rows and not ctx.json:
        return 'No notes yet. Add one with: {{name}} add "Bought milk"'
    return rows


@app.command("add", kind="write")
def add(ctx, text: Annotated[str, "the note to save"]):
    """Save a new note."""
    text = text.strip()
    if not text:
        raise UsageError(
            "The note is empty, so nothing was saved.",
            hint='Give the text of the note, for example: {{name}} add "Bought milk"',
        )
    row = {"time": datetime.now(timezone.utc).isoformat(timespec="seconds"), "text": text}
    with closing(_connect(ctx)) as conn, conn:
        conn.execute("INSERT INTO notes (time, text) VALUES (:time, :text)", row)
    return {"saved": True, **row}


@app.command("rebuild", kind="write")
def rebuild(ctx):
    """Rebuild the table of notes per day from the raw notes (the "rebuild" job)."""
    with closing(_connect(ctx)) as conn, conn:  # one transaction: readers never see half a table
        conn.execute("DELETE FROM daily")
        conn.execute("INSERT INTO daily (day, notes) SELECT substr(time, 1, 10), count(*) FROM notes GROUP BY 1")
        days, total = conn.execute("SELECT count(*), coalesce(sum(notes), 0) FROM daily").fetchone()
    return {"table": "daily", "rows": days, "notes": total}


@app.schema
def schema(ctx):
    return {
        "file": DATA_FILE,
        "tables": [
            {"name": "notes", "layer": "raw", "fields": {"time": "UTC date and time", "text": "the note"}},
            {"name": "daily", "layer": "derived", "built_by": "rebuild",
             "fields": {"day": "date (YYYY-MM-DD, UTC)", "notes": "number of notes that day"}},
        ],
    }


@app.sources
def sources(ctx):
    return [{"name": "manual", "meaning": "Notes typed in with the add command."}]


def main() -> None:
    app.main()


if __name__ == "__main__":
    main()
